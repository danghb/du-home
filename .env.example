APP_HOST=0.0.0.0
APP_PORT=3000
APP_TIMEZONE=Asia/Hong_Kong
APP_DATA_MODE=mock
PHOTO_ROOT=./sample-photos
PHOTO_CACHE_ROOT=./cache/photos
PHOTO_SCAN_INTERVAL_MINUTES=60
HA_BASE_URL=https://home-assistant.example.com/
HA_TOKEN=
# 可留空，服务会自动选择第一个 weather.* 实体；有多个天气实体时请显式填写。
HA_WEATHER_ENTITY=
HA_WEATHER_REFRESH_MINUTES=5
HA_DATA_REFRESH_SECONDS=30

# 以下变量仅供 docker-compose.yml 在 NAS 上解析，不影响本地 Node.js 开发。
DISPLAY_PORT=3000
PHOTO_HOST_PATH=/volume1/photos
